SECRET_KEY=replace-with-a-long-random-value
PASSWORD_MIN_LENGTH=8
TMDB_API_KEY=
# Optional paid UPCitemdb key. Kept on the Homebuster server only.
UPCITEMDB_API_KEY=
# Set true to use UPCitemdb's no-key trial endpoint instead.
UPCITEMDB_FREE_ENABLED=false
# Optional alternative server-side barcode endpoint. Homebuster calls it as GET ?upc=...
BARCODE_LOOKUP_URL=
