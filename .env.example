# Registration is intentionally OFF by default. Turn it on when you want people to register.
ALLOW_REGISTRATION=false

# Optional first-boot admin. Remove INITIAL_ADMIN_PASSWORD after the account exists.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Optional. If omitted, the app generates a persistent secret in ./data/.secret_key.
SECRET_KEY=

# Optional TMDb API key for poster/title identification.
TMDB_API_KEY=
TMDB_POSTER_SIZE=w342

# Set true only when the browser reaches the app through HTTPS.
SESSION_COOKIE_SECURE=false

PAGE_SIZE=60
